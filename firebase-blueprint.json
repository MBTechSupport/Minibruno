{
  "entities": {
    "Ticket": {
      "title": "Ticket",
      "description": "Ticket de soporte técnico generado por usuarios de Mini Bruno",
      "type": "object",
      "properties": {
        "ticketCode": {
          "type": "string",
          "description": "Código corporativo único del ticket, ej: #TK-2026-0412"
        },
        "userId": {
          "type": "string",
          "description": "UID del usuario en Firebase Auth"
        },
        "userEmail": {
          "type": "string",
          "format": "email",
          "description": "Correo corporativo del usuario creador"
        },
        "userName": {
          "type": "string",
          "description": "Nombre del usuario creador"
        },
        "department": {
          "type": "string",
          "description": "Departamento interno de Mini Bruno",
          "enum": [
            "Sistemas / TI",
            "Planta / Operaciones",
            "Logística y Transporte",
            "Ventas / Comercial",
            "Administración / RRHH",
            "Control de Calidad",
            "Otro"
          ]
        },
        "category": {
          "type": "string",
          "description": "Categoría de la incidencia",
          "enum": [
            "Incidencia Técnica",
            "Acceso a Sistemas / Cuentas",
            "Falla de Equipos / Red",
            "Consulta Operativa",
            "Solicitud General"
          ]
        },
        "priority": {
          "type": "string",
          "description": "Nivel de urgencia del ticket",
          "enum": ["Baja", "Media", "Alta", "Crítica"]
        },
        "subject": {
          "type": "string",
          "description": "Asunto resumido del problema",
          "minLength": 3,
          "maxLength": 150
        },
        "description": {
          "type": "string",
          "description": "Detalles completos de la solicitud o falla técnica",
          "minLength": 5,
          "maxLength": 4000
        },
        "status": {
          "type": "string",
          "description": "Estado operativo del ticket",
          "enum": ["Abierto", "En revisión", "Resuelto"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Fecha ISO de creación"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Fecha ISO de última actualización"
        }
      },
      "required": [
        "ticketCode",
        "userId",
        "userEmail",
        "department",
        "category",
        "priority",
        "subject",
        "description",
        "status",
        "createdAt"
      ]
    },
    "News": {
      "title": "News",
      "description": "Noticia o comunicado corporativo/tecnológico de Mini Bruno",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Título de la noticia",
          "minLength": 3,
          "maxLength": 200
        },
        "summary": {
          "type": "string",
          "description": "Resumen corto de la noticia",
          "minLength": 5,
          "maxLength": 600
        },
        "content": {
          "type": "string",
          "description": "Cuerpo completo de la noticia (HTML/texto)",
          "minLength": 10,
          "maxLength": 25000
        },
        "category": {
          "type": "string",
          "description": "Categoría de la noticia",
          "enum": [
            "innovacion",
            "seguridad",
            "software",
            "hardware",
            "gaming",
            "moviles",
            "internet",
            "reviews",
            "entrevistas"
          ]
        },
        "tags": {
          "type": "array",
          "description": "Etiquetas de la noticia",
          "items": {
            "type": "string"
          }
        },
        "authorName": {
          "type": "string",
          "description": "Nombre del autor o redactor"
        },
        "authorRole": {
          "type": "string",
          "description": "Cargo o rol del autor"
        },
        "createdByEmail": {
          "type": "string",
          "format": "email",
          "description": "Correo del administrador que publicó la noticia"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Fecha ISO de publicación"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Fecha ISO de última actualización"
        }
      },
      "required": [
        "title",
        "summary",
        "content",
        "category",
        "authorName",
        "createdAt"
      ]
    },
    "InternalTicketMessage": {
      "title": "InternalTicketMessage",
      "description": "Mensaje en tiempo real del chat interno exclusivo para Staff IT sobre un ticket",
      "type": "object",
      "properties": {
        "ticketId": {
          "type": "string",
          "description": "ID del ticket asociado"
        },
        "senderUid": {
          "type": "string",
          "description": "UID de Firebase Auth del remitente autorizado"
        },
        "senderEmail": {
          "type": "string",
          "format": "email",
          "description": "Correo corporativo del remitente autorizado"
        },
        "senderName": {
          "type": "string",
          "description": "Nombre visible del remitente"
        },
        "text": {
          "type": "string",
          "description": "Contenido del mensaje de discusión técnica",
          "minLength": 1,
          "maxLength": 3000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Fecha y hora ISO de emisión"
        }
      },
      "required": [
        "ticketId",
        "senderUid",
        "senderEmail",
        "senderName",
        "text",
        "createdAt"
      ]
    },
    "CorporateContact": {
      "title": "CorporateContact",
      "description": "Contacto del directorio corporativo y vCard administrable por Staff IT",
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "description": "Identificador numérico ordenado del contacto"
        },
        "name": {
          "type": "string",
          "description": "Nombre y apellido del contacto"
        },
        "position": {
          "type": "string",
          "description": "Cargo en la organización"
        },
        "department": {
          "type": "string",
          "description": "Departamento o área corporativa"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Correo electrónico corporativo"
        },
        "phone": {
          "type": "string",
          "description": "Número telefónico de contacto directo"
        },
        "ext": {
          "type": "string",
          "description": "Extensión telefónica interna"
        },
        "location": {
          "type": "string",
          "description": "Sede o planta de asignación (ej. Planta PRC, Planta PSC, Chuao)"
        },
        "hours": {
          "type": "string",
          "description": "Horario laboral de atención"
        },
        "notes": {
          "type": "string",
          "description": "Descripción profesional o notas de funciones"
        },
        "avatar": {
          "type": "string",
          "description": "Ruta relativa o URL/DataURI de la fotografía del contacto"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Fecha y hora ISO de última actualización"
        },
        "updatedBy": {
          "type": "string",
          "format": "email",
          "description": "Correo del administrador que realizó la última edición"
        }
      },
      "required": [
        "name",
        "position",
        "department",
        "email"
      ]
    }
  },
  "firestore": {
    "/tickets/{ticketId}": {
      "schema": "#/entities/Ticket",
      "description": "Colección de tickets de soporte técnico"
    },
    "/tickets/{ticketId}/internal_messages/{messageId}": {
      "schema": "#/entities/InternalTicketMessage",
      "description": "Subcolección de mensajes del chat interno para personal autorizado"
    },
    "/news/{newsId}": {
      "schema": "#/entities/News",
      "description": "Colección de noticias corporativas y tecnológicas"
    },
    "/contacts/{contactId}": {
      "schema": "#/entities/CorporateContact",
      "description": "Colección de contactos y vCards corporativas administrables"
    }
  }
}
